# Rootstock RPC Endpoints
# Optional: Override default public RPC endpoints
# Use these if you have API keys for higher rate limits or custom endpoints
NEXT_PUBLIC_ROOTSTOCK_RPC_MAINNET=https://public-node.rsk.co
NEXT_PUBLIC_ROOTSTOCK_RPC_TESTNET=https://public-node.testnet.rsk.co

# Example with API key (if you have one):
# NEXT_PUBLIC_ROOTSTOCK_RPC_MAINNET=https://rpc.rootstock.io/your-api-key
# NEXT_PUBLIC_ROOTSTOCK_RPC_TESTNET=https://rpc.testnet.rootstock.io/your-api-key

# Block Explorer API Endpoints
# Optional: Override default Blockscout API endpoints
NEXT_PUBLIC_BLOCKSCOUT_API_MAINNET=https://rootstock.blockscout.com/api
NEXT_PUBLIC_BLOCKSCOUT_API_TESTNET=https://rootstock-testnet.blockscout.com/api

# Note: All variables are optional. The app works with default public endpoints.
# Configure these only if you need custom endpoints or have API keys for better rate limits.
